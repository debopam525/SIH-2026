# Copy to .env for local runs. Docker compose sets its own values.

ECDAT_ENV=dev
ECDAT_DATABASE_URL=sqlite+pysqlite:///./ecdat.db
# Postgres example:
# ECDAT_DATABASE_URL=postgresql+psycopg://ecdat:ecdat@localhost:5432/ecdat

ECDAT_JWT_SECRET=change-me-in-production-please-32-chars-min
ECDAT_JWT_ACCESS_TTL_MINUTES=30
ECDAT_JWT_REFRESH_TTL_MINUTES=1440

ECDAT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ECDAT_SCAN_WORKDIR=./.ecdat_work
ECDAT_REPORTS_DIR=./reports_out
ECDAT_LOG_LEVEL=INFO
ECDAT_LOG_JSON=false

# Analysis assumptions (also editable at runtime in Settings by an admin)
ECDAT_CRQC_HORIZON_YEARS=15
